# Environment Configuration for Twitch Clapback Bot (Python)

# ================================
# TWITCH CONFIGURATION (REQUIRED)
# ================================

# Your bot's Twitch username (create a separate account for the bot)
TWITCH_BOT_USERNAME=your_bot_username

# OAuth token for your bot account (get from https://twitchtokengenerator.com/)
TWITCH_OAUTH_TOKEN=your_oauth_token_here

# Twitch channel to monitor (without #)
TWITCH_CHANNEL=your_channel_name 

MODEL_API_URL="your_model_api_url"